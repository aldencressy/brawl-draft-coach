{
  "name": "brawl-draft-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live drafting coach for Brawl Stars ranked",
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "scripts": {
    "verify-key": "tsx scripts/verify-key.ts",
    "inspect": "tsx scripts/inspect.ts",
    "collect": "tsx scripts/collect.ts",
    "outputs": "tsx scripts/outputs.ts",
    "checklist": "tsx scripts/checklist.ts",
    "suggest": "tsx scripts/suggest.ts",
    "dev": "vite",
    "build:web": "vite build && mkdir -p dist/data && cp ${DATA_DIR:-data}/out/*.json dist/data/",
    "preview": "vite preview",
    "mock": "tsx mock/server.ts",
    "fixtures": "node fixtures/generate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.0"
  }
}
