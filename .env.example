# Copy to .env and fill in. Never commit .env.

# Your Brawl Stars API key (developer.brawlstars.com), allowlisted for 45.79.218.79
BS_API_KEY=

# RoyaleAPI proxy. Use http://localhost:8787/v1 to hit the mock server instead.
BS_API_BASE=https://bsproxy.royaleapi.dev/v1

# Your player tag, with or without the leading #
MY_TAG=

# Max requests per second sent to the API
BS_RATE_LIMIT_RPS=8
